    { "name": "money with 2 decimals", "scheme": { "copayPct": 15 }, "total": 19.99, "decimals": 2, "expect": { "copay": 3, "insurer": 16.99 } },
    { "name": "a percentage above 100 counts as 100", "scheme": { "copayPct": 150 }, "total": 1000, "decimals": 0, "expect": { "copay": 1000, "insurer": 0 } }
