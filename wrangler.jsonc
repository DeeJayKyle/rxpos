// Cloudflare Workers config: web app (dist/) + sync API (worker/index.js) + D1 database.
// Deploy: connect this GitHub repo in Cloudflare → Workers & Pages → Create → Import a repository.
//   Build command: npm ci && npm run build      Deploy command: npx wrangler deploy
// Then add the secret SYNC_KEY (Settings → Variables and Secrets). The D1 database is created automatically.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Internal Cloudflare names kept from before the rename (never shown; renaming would need every secret re-entered).
  // Everyone reaches it as api.rxposug.com / rxposug.com.
  "name": "pharmapos",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "pharmapos-db", "database_id": "a68d2d61-c865-4a2b-9a83-65d20a0927f0", "migrations_dir": "migrations" }],
  // Database: "" = Cloudflare D1 (binding DB); "turso" = libSQL/Turso (secrets TURSO_URL, TURSO_AUTH_TOKEN; see deploy/setup-turso.ps1)
  "vars": { "DB_BACKEND": "turso", "PUBLIC_URL": "https://rxposug.com", "BREVO_SENDER_EMAIL": "no-reply@rxposug.com", "BREVO_SENDER_NAME": "RxPOS" },
  // Password-reset emails go through Brevo (free plan): the API key is the secret BREVO_API_KEY (wrangler secret put BREVO_API_KEY)
  // Own domain for the apps (api.rxposug.com); the free workers.dev address stays on for devices set up before
  "workers_dev": true,
  // Mondays 06:00 UTC: keep the Brevo API key active (worker/index.js → scheduled)
  "triggers": { "crons": ["0 6 * * 1"] },
  "routes": [{ "pattern": "api.rxposug.com", "custom_domain": true }],
  // Cloudflare Workers AI (open models) for prescription reading and drug quizzes
  "ai": { "binding": "AI" },
  // Live connection per pharmacy: instant sync notifications and call set-up (worker/live.js)
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "TenantHub" }] },
  "migrations": [{ "tag": "v1-live", "new_sqlite_classes": ["TenantHub"] }],
  "observability": { "enabled": true }
}
