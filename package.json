{
  "name": "pharmapos",
  "productName": "RxPOS",
  "version": "1.2.1",
  "description": "RxPOS - pharmacy point of sale and inventory management",
  "author": "RxPOS",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win --publish never",
    "hub": "node server/hub.mjs"
  },
  "dependencies": {
    "@capacitor/android": "6.2.2",
    "@capacitor/core": "6.2.2",
    "@fontsource-variable/inter": "5.3.0",
    "lucide-react": "1.48.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2",
    "read-excel-file": "9.3.10"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.2",
    "@vitejs/plugin-react": "4.3.1",
    "electron": "31.4.0",
    "electron-builder": "24.13.3",
    "vite": "5.4.8",
    "wrangler": "4.142.0"
  },
  "build": {
    "appId": "io.github.pharmapos",
    "productName": "RxPOS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RxPOS"
    },
    "portable": {
      "artifactName": "RxPOS-Portable-${version}.exe"
    }
  }
}
