{
  "name": "rxpos",
  "productName": "RxPOS",
  "version": "1.0.3",
  "description": "RxPOS - pharmacy point of sale and inventory management",
  "author": "RxPOS",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win --publish never",
    "hub": "node server/hub.mjs",
    "test": "node tests/run-all.mjs",
    "backup": "node tools/backup.mjs",
    "restore": "node tools/restore.mjs"
  },
  "dependencies": {
    "@capacitor/android": "6.2.2",
    "@capacitor/core": "6.2.2",
    "@capacitor/filesystem": "6.0.4",
    "@capacitor/local-notifications": "6.1.3",
    "@capacitor/screen-orientation": "6.0.4",
    "@capacitor/share": "6.0.4",
    "@capgo/capacitor-updater": "6.51.23",
    "@fontsource-variable/inter": "5.3.0",
    "barcode-detector": "3.2.2",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "lucide-react": "1.48.0",
    "pdfjs-dist": "5.7.284",
    "qrcode-generator": "2.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2",
    "read-excel-file": "9.3.10"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.2",
    "@libsql/client": "0.18.0",
    "@vitejs/plugin-react": "4.3.1",
    "electron": "43.7.8",
    "electron-builder": "24.13.3",
    "puppeteer-core": "25.12.0",
    "vite": "5.4.8",
    "wrangler": "4.142.0"
  },
  "build": {
    "appId": "io.github.rxpos",
    "productName": "RxPOS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/updates/**",
      "electron/**/*",
      "server/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RxPOS"
    },
    "portable": {
      "artifactName": "RxPOS-Portable-${version}.exe"
    }
  }
}
